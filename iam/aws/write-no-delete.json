{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSandboxServices",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "elasticloadbalancing:*",
        "autoscaling:*",
        "ecs:*",
        "ecr:*",
        "lambda:*",
        "apigateway:*",
        "s3:*",
        "dynamodb:*",
        "sqs:*",
        "sns:*",
        "events:*",
        "states:*",
        "logs:*",
        "cloudwatch:*",
        "cloudformation:*",
        "rds:*",
        "elasticache:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassAgentRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/agent-sandbox/*"
    },
    {
      "Sid": "DenyDeletes",
      "Effect": "Deny",
      "Action": [
        "ec2:Delete*",
        "ec2:Terminate*",
        "ec2:Deregister*",
        "ec2:Release*",
        "ec2:Deprovision*",
        "elasticloadbalancing:Delete*",
        "elasticloadbalancing:Remove*",
        "elasticloadbalancing:Deregister*",
        "autoscaling:Delete*",
        "autoscaling:Terminate*",
        "ecs:Delete*",
        "ecs:Deregister*",
        "ecr:Delete*",
        "ecr:Deregister*",
        "lambda:Delete*",
        "lambda:Terminate*",
        "lambda:Remove*",
        "apigateway:Delete*",
        "apigateway:Remove*",
        "s3:Delete*",
        "dynamodb:Delete*",
        "sqs:Delete*",
        "sqs:Remove*",
        "sqs:Purge*",
        "sns:Delete*",
        "sns:Remove*",
        "events:Delete*",
        "events:Remove*",
        "states:Delete*",
        "logs:Delete*",
        "cloudwatch:Delete*",
        "cloudformation:Delete*",
        "cloudformation:Deregister*",
        "rds:Delete*",
        "rds:Remove*",
        "rds:Deregister*",
        "elasticache:Delete*",
        "elasticache:Remove*",
        "ec2:CancelSpotFleetRequests",
        "s3:PutLifecycleConfiguration",
        "ecr:PutLifecyclePolicy",
        "logs:PutRetentionPolicy",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyPurchases",
      "Effect": "Deny",
      "Action": [
        "ec2:Purchase*",
        "dynamodb:Purchase*",
        "rds:Purchase*",
        "elasticache:Purchase*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyResourcePolicyChanges",
      "Effect": "Deny",
      "Action": [
        "ec2:AttachApplianceToNatGateway",
        "ec2:AttachResourcesToPlacementGroup",
        "ec2:CancelImageLaunchPermission",
        "ec2:CreateCoipPoolPermission",
        "ec2:CreateLocalGatewayRouteTablePermission",
        "ec2:CreateNetworkInterfacePermission",
        "ec2:CreateOdbNetworkPeering",
        "ec2:DetachApplianceFromNatGateway",
        "ec2:DetachResourcesFromPlacementGroup",
        "ec2:DisableImageBlockPublicAccess",
        "ec2:DisableSnapshotBlockPublicAccess",
        "ec2:EnableImageBlockPublicAccess",
        "ec2:EnableSnapshotBlockPublicAccess",
        "ec2:ModifyOdbNetworkPeering",
        "ec2:ModifyImageAttribute",
        "ec2:ModifySnapshotAttribute",
        "ec2:ModifyVpcEndpointServicePermissions",
        "ec2:PutResourcePolicy",
        "ec2:ResetSnapshotAttribute",
        "elasticloadbalancing:AllowVendedLogDeliveryForResource",
        "ecs:AllowVendedLogDeliveryForResource",
        "ecr:PutRegistryPolicy",
        "ecr:SetRepositoryPolicy",
        "lambda:AddLayerVersionPermission",
        "lambda:AddPermission",
        "lambda:DisableReplication",
        "lambda:EnableReplication",
        "lambda:PutResourcePolicy",
        "apigateway:AddCertificateToDomain",
        "apigateway:CreateAccessAssociation",
        "apigateway:PutPortalProductSharingPolicy",
        "apigateway:RejectAccessAssociation",
        "apigateway:SetWebACL",
        "apigateway:UpdateDomainNameManagementPolicy",
        "apigateway:UpdateDomainNamePolicy",
        "apigateway:UpdateRestApiPolicy",
        "s3:AssociateAccessGrantsIdentityCenter",
        "s3:BypassGovernanceRetention",
        "s3:CreateAccessGrant",
        "s3:CreateAccessGrantsInstance",
        "s3:CreateAccessGrantsLocation",
        "s3:DissociateAccessGrantsIdentityCenter",
        "s3:ObjectOwnerOverrideToBucketOwner",
        "s3:PutAccessGrantsInstanceResourcePolicy",
        "s3:PutAccessPointPolicy",
        "s3:PutAccessPointPolicyForObjectLambda",
        "s3:PutAccessPointPublicAccessBlock",
        "s3:PutAccountPublicAccessBlock",
        "s3:PutBucketAcl",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutMultiRegionAccessPointPolicy",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl",
        "s3:UpdateAccessGrantsLocation",
        "dynamodb:PutResourcePolicy",
        "dynamodb:UpdateAbacStatus",
        "sqs:AddPermission",
        "sqs:SetQueueAttributes",
        "sns:AddPermission",
        "sns:SetTopicAttributes",
        "events:PutPermission",
        "events:PutResourcePolicy",
        "logs:PutResourcePolicy",
        "cloudwatch:AssumeAccessProfile",
        "cloudwatch:CreateAccessGrant",
        "cloudwatch:CreateAccessProfile",
        "cloudwatch:CreateDomainAccessGrantForOrganization",
        "cloudwatch:UpdateAccessProfile",
        "cloudformation:SetStackPolicy",
        "rds:AuthorizeDBSecurityGroupIngress"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIdentityOrgBillingChanges",
      "Effect": "Deny",
      "Action": [
        "iam:Accept*",
        "iam:Add*",
        "iam:Associate*",
        "iam:Attach*",
        "iam:Change*",
        "iam:Create*",
        "iam:Deactivate*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Disable*",
        "iam:Enable*",
        "iam:Put*",
        "iam:Reject*",
        "iam:Remove*",
        "iam:Reset*",
        "iam:Resync*",
        "iam:Send*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Update*",
        "iam:Upload*",
        "organizations:Accept*",
        "organizations:Attach*",
        "organizations:Cancel*",
        "organizations:Close*",
        "organizations:Create*",
        "organizations:Decline*",
        "organizations:Delete*",
        "organizations:Deregister*",
        "organizations:Detach*",
        "organizations:Disable*",
        "organizations:Enable*",
        "organizations:Invite*",
        "organizations:Leave*",
        "organizations:Move*",
        "organizations:Put*",
        "organizations:Register*",
        "organizations:Remove*",
        "organizations:Tag*",
        "organizations:Terminate*",
        "organizations:Untag*",
        "organizations:Update*",
        "account:*",
        "aws-portal:*",
        "billing:*",
        "billingconductor:*",
        "bcm-data-exports:*",
        "budgets:*",
        "ce:*",
        "consolidatedbilling:*",
        "cur:*",
        "freetier:*",
        "invoicing:*",
        "payments:*",
        "purchase-orders:*",
        "savingsplans:*",
        "tax:*",
        "sts:AssumeRole",
        "sts:AssumeRoleWithSAML",
        "sts:AssumeRoleWithWebIdentity",
        "sts:AssumeRoot",
        "sts:GetFederationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySecretsAndDecrypt",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:GetParameterHistory",
        "kms:Decrypt",
        "ec2:GetPasswordData"
      ],
      "Resource": "*"
    }
  ]
}
