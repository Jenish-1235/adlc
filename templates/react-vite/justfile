set shell := ["bash", "-euo", "pipefail", "-c"]

# The compose project is named after the project folder, so each project gets its
# own containers and volumes (shop-db-1, shop_db) instead of sharing "local".
compose := "docker compose -p " + file_name(justfile_directory()) + " -f deploy/local/docker-compose.yml"

# Install dependencies and git hooks
setup:
    pnpm install --frozen-lockfile
    git config core.hooksPath .githooks
    if [ -n "$(find deploy/terraform -name '*.tf' -print -quit)" ]; then tflint --init --config=deploy/terraform/.tflint.hcl; fi

# Run the app; PORT and HOST override the defaults
dev:
    pnpm vite --port "${PORT:-5173}" --host "${HOST:-127.0.0.1}" --strictPort

# Run tests with coverage
test:
    pnpm vitest run --coverage

# Check style and types
lint:
    pnpm eslint . --max-warnings 0
    pnpm tsc --noEmit
    if [ -n "$(find deploy/terraform -name '*.tf' -print -quit)" ]; then terraform fmt -check -recursive deploy/terraform && tflint --chdir=deploy/terraform --recursive --config="{{ justfile_directory() }}/deploy/terraform/.tflint.hcl"; fi

# Start local services (databases, queues) from deploy/local
up:
    if {{ compose }} config --services 2>/dev/null | grep -q .; then {{ compose }} up -d --wait; else echo "No local services yet: add them to deploy/local/docker-compose.yml"; fi

# Stop local services (data is kept)
down:
    {{ compose }} down
