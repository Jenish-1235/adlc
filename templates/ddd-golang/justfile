setup:
    go mod download
    tflint --init --config=deploy/terraform/.tflint.hcl
    git config core.hooksPath .githooks

dev:
    go run ./cmd/api

test:
    go test -race -coverprofile=coverage.out ./...

lint:
    golangci-lint run
    ! grep -rn --include='*.go' '//nolint' .
    go-arch-lint check
    squawk --no-error-on-unmatched-pattern 'migrations/*.sql'
    terraform fmt -check -recursive deploy/terraform
    tflint --chdir=deploy/terraform --recursive --config="{{ justfile_directory() }}/deploy/terraform/.tflint.hcl"

up:
    docker compose -f deploy/local/docker-compose.yml up -d --wait

down:
    docker compose -f deploy/local/docker-compose.yml down
